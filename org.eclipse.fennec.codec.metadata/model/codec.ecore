      <details key="documentation" value="Codec aspect for EStructuralFeature serialization configuration. Attached to FeatureMetadata.aspects."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="effectiveKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
