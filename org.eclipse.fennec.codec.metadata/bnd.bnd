Bundle-Name: Fennec Codec Metadata
Bundle-Description: Codec-specific aspects for the Model Metadata Service

src=${^src},src-gen

-library: enableEMF

-includeresource.model: model=model

-generate:\
	model/codec.genmodel;\
		generate=fennecEMF;\
		genmodel=model/codec.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest
