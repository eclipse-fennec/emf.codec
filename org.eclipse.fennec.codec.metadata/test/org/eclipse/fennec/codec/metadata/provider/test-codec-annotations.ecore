      <details key="strictOnUnknown" value="true"/>
      <details key="strictOnMissing" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(11-feature.md §11): Only strictOnUnknown on EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="StrictUnknownOnly">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="strictOnUnknown" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
