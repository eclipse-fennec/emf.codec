  </eClassifiers>

  <!-- @MISCONFIG @SPEC(05-global-options.md §5.7): metadataMerge on EAttribute -->
  <!-- Expected: Key is IGNORED with ERROR - metadata merge is class-only -->
  <eClassifiers xsi:type="ecore:EClass" name="AttrWithMetadataMergeMisplaced">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- metadataMerge is class-only, should be ignored on attribute -->
        <details key="metadataMerge" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- @MISCONFIG @SPEC(05-global-options.md §5.7): metadataKey on EReference -->
  <!-- Expected: Key is IGNORED with ERROR - metadata key is class-only -->
  <eClassifiers xsi:type="ecore:EClass" name="RefWithMetadataKeyMisplaced">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- metadataKey is class-only, should be ignored on reference -->
        <details key="metadataKey" value="_meta"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- @MISCONFIG @SPEC(05-global-options.md §5.7): Both metadata merge keys on EAttribute -->
  <!-- Expected: Both keys IGNORED with ERROR - metadata merge is class-only -->
  <eClassifiers xsi:type="ecore:EClass" name="AttrWithBothMetadataMergeMisplaced">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="metadataMerge" value="true"/>
        <details key="metadataKey" value="_meta"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- @MISCONFIG @SPEC(09-id.md#4.4): idKey/idFormat on a NON-containment EReference (issue #189) -->
  <!-- Expected: containment reference parses them; non-containment reference drops them with a WARNING -->
  <eClassifiers xsi:type="ecore:EClass" name="RefWithIdKeyOnNonContainment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="idKey" value="addrId"/>
        <details key="idFormat" value="STRUCTURED"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cachedAddress" eType="#//Address">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- A non-containment reference writes a $ref, there is no id key to rename -->
        <details key="idKey" value="addrId"/>
        <details key="idFormat" value="STRUCTURED"/>
        <!-- Valid key for reference -->
        <details key="typeStrategy" value="NAME"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

</ecore:EPackage>
