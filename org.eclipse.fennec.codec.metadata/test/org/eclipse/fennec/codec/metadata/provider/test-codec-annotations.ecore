    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- These are runtime-only properties, not valid in EAnnotations -->
        <details key="idScope" value="ROOT_ONLY"/>
        <details key="idFormatScope" value="ROOT_CONTAINMENT"/>
        <!-- Valid key for reference -->
        <details key="key" value="addr"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       STRICTNESS TESTS (11-feature.md §11)
       ======================================================================== -->

  <!-- @VALID @SPEC(11-feature.md §11): Strictness flags on EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="StrictEntity">
