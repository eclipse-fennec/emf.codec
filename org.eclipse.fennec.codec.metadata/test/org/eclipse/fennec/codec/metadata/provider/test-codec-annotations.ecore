<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="testcodec" nsURI="http://test.codec.example.org/1.0" nsPrefix="testcodec">

  <!-- @VALID: Simple class without annotations - tests default behavior -->
  <eClassifiers xsi:type="ecore:EClass" name="SimpleClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- @VALID @SPEC(09-id.md): ID_FIELD strategy with idKey -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithIdField">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idStrategy" value="ID_FIELD"/>
      <details key="idKey" value="_id"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(09-id.md): COMBINED strategy with features and separator -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithCombinedId">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idStrategy" value="COMBINED"/>
      <details key="idKey" value="_id"/>
      <details key="idSeparator" value="-"/>
      <details key="idFeatures" value="firstName,lastName"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(09-id.md): NONE keyMode - no ID serialization (NONE moved from IdStrategy to IdKeyMode per spec) -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithNoId">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idKeyMode" value="NONE"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(06-type.md): URI type strategy with typeKey -->
  <eClassifiers xsi:type="ecore:EClass" name="TypedEntityUri">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeStrategy" value="URI"/>
      <details key="typeKey" value="_type"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(06-type.md): NAME type strategy -->
  <eClassifiers xsi:type="ecore:EClass" name="TypedEntityName">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeStrategy" value="NAME"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(08-discriminator-mapping.md): Discriminator path on EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="TypedEntityWithDiscriminator">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeStrategy" value="NAME"/>
    </eAnnotations>
    <eAnnotations source="http://eclipse.org/fennec/codec/typeMapping/device-types">
      <details key="typeDiscriminatorPath" value="deviceInfo.profileName"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(06-type.md): TypeStrategy.NONE suppresses type information -->
  <eClassifiers xsi:type="ecore:EClass" name="TypedEntityNoInclude">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeStrategy" value="NONE"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(07-supertype.md): SuperType enabled with ALL strategy -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithSuperTypes">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="superTypeSerialize" value="true"/>
      <details key="superTypeKey" value="_superTypes"/>
      <details key="superTypeStrategy" value="ALL"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(07-supertype.md): SINGLE supertype selection -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithSingleSuperType">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="superTypeSerialize" value="true"/>
      <details key="superTypeStrategy" value="SINGLE"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(07-supertype.md): superTypeAsArray=false -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithSuperTypesNotAsArray">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="superTypeSerialize" value="true"/>
      <details key="superTypeAsArray" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(07-supertype.md): Custom supertype separator -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithSuperTypesSeparator">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="superTypeSerialize" value="true"/>
      <details key="superTypeAsArray" value="false"/>
      <details key="superTypeSeparator" value="|"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID: Inherit annotation for parent config inheritance -->
  <eClassifiers xsi:type="ecore:EClass" name="InheritingEntity">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="inherit" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with discriminator value (using typeMapping/lorawan-dynamic source) -->
  <eClassifiers xsi:type="ecore:EClass" name="DraginoDevice">
    <eAnnotations source="http://eclipse.org/fennec/codec/typeMapping/lorawan-dynamic">
      <details key="typeDiscriminator" value="Dragino_LSE01"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with custom ID reader/writer -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithCustomIdHandlers">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idValueReaderName" value="CustomIdReader"/>
      <details key="idValueWriterName" value="CustomIdWriter"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
  </eClassifiers>

  <!-- Class with all configs combined in single annotation -->
  <eClassifiers xsi:type="ecore:EClass" name="FullyConfiguredEntity">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idStrategy" value="ID_FIELD"/>
      <details key="typeStrategy" value="URI"/>
      <details key="superTypeSerialize" value="true"/>
      <details key="inherit" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with ignored attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithTransientField">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="publicData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secretData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="ignore" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Class with value reader/writer on attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithCustomValueHandlers">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="valueWriterName" value="ISO8601DateWriter"/>
        <details key="valueReaderName" value="FlexibleDateReader"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="onlyWriter" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="valueWriterName" value="CustomWriter"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="onlyReader" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="valueReaderName" value="CustomReader"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Address class for reference testing -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with reference containing type annotation -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithTypedReference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="typeStrategy" value="NAME"/>
        <details key="typeKey" value="_refType"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Class with ignored reference -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithTransientReference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cachedAddress" eType="#//Address">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="ignore" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       NEW ANNOTATION KEY TESTS (ID Format, KeyMode, OnTop, etc.)
       ======================================================================== -->

  <!-- Class with full ID configuration including format/keyMode/onTop -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithStructuredId">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idStrategy" value="COMBINED"/>
      <details key="idFeatures" value="firstName,lastName"/>
      <details key="idFormat" value="STRUCTURED"/>
      <details key="idKeyMode" value="BOTH"/>
      <details key="idOnTop" value="false"/>
      <details key="idSeparatorSerialize" value="true"/>
      <details key="idSeparatorKey" value="sep"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with idKeyMode=NONE - no ID serialization at all -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithIdKeyModeNone">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idStrategy" value="COMBINED"/>
      <details key="idFeatures" value="firstName,lastName"/>
      <details key="idKeyMode" value="NONE"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with type configuration including format/schemaKey/nameKey -->
  <eClassifiers xsi:type="ecore:EClass" name="TypedEntityStructured">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeStrategy" value="SCHEMA_AND_TYPE"/>
      <details key="typeFormat" value="STRUCTURED"/>
      <details key="typeSchemaKey" value="$schema"/>
      <details key="typeNameKey" value="typeName"/>
      <details key="typeKey" value="typeInfo"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class with supertype configuration including format/nameKey (schemaKey inherits from TypeConfig) -->
  <!-- Note: superTypeNameKey removed - superTypeKey has format-dependent default -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithStructuredSuperType">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="superTypeSerialize" value="true"/>
      <details key="superTypeFormat" value="STRUCTURED"/>
      <details key="superTypeKey" value="typeName"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- ========================================================================
       REFERENCE CONFIGURATION TESTS
       ======================================================================== -->

  <!-- Class with reference containing full refConfig (refFormat, refKey, refTypeKey) -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithRefConfig">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employer" eType="#//Company">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="refFormat" value="STRUCTURED"/>
        <details key="refKey" value="$ref"/>
        <details key="refTypeKey" value="$type"/>
        <details key="expand" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Company class for reference testing -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- ========================================================================
       INLINE TYPE MAPPING TESTS
       ======================================================================== -->

  <!-- Contact base class for polymorphic testing -->
  <eClassifiers xsi:type="ecore:EClass" name="Contact">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contactType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Friend subclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Friend" eSuperTypes="#//Contact">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="friendSince" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <!-- Enemy subclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Enemy" eSuperTypes="#//Contact">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grudge" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- @VALID @SPEC(08-discriminator-mapping.md): Inline type mappings on EReference -->
  <!-- @MISCONFIG: typeDiscriminatorPath is class-only per spec section 7 -->
  <!-- Expected: typeDiscriminatorPath is IGNORED with diagnostic, inlineMappings ARE parsed from dedicated source -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithContacts">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contacts" upperBound="-1" eType="#//Contact" containment="true">
      <!-- @MISCONFIG: typeDiscriminatorPath is class-only, should generate diagnostic -->
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="typeDiscriminatorPath" value="contactType"/>
      </eAnnotations>
      <!-- Inline mappings on dedicated inlineMapping source -->
      <eAnnotations source="http://eclipse.org/fennec/codec/inlineMapping">
        <details key="friend" value="http://test.codec.example.org/1.0#//Friend"/>
        <details key="enemy" value="http://test.codec.example.org/1.0#//Enemy"/>
        <details key="colleague" value="http://test.codec.example.org/1.0#//Contact"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       FEATURE SERIALIZE OPTIONS TESTS
       ======================================================================== -->

  <!-- Class with various visibility and serialize options on attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithSerializeOptions">
    <!-- Explicitly ignore=false (not ignored) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="explicitSerialize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="ignore" value="false"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- ignore=true (skip both read and write) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="noSerialize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="ignore" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- ignore=false explicitly set -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="conflictSerializeWins" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="ignore" value="false"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- serializeNull=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nullableField" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="serializeNull" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- serializeEmpty=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emptyListField" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="serializeEmpty" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- serializeDefaults=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValueField" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="serializeDefaults" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       ENUM SERIALIZATION TESTS
       ======================================================================== -->

  <!-- Status enum for enum serialization testing -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="INACTIVE" value="2" literal="inactive"/>
    <eLiterals name="PENDING" value="3" literal="pending"/>
  </eClassifiers>

  <!-- Class with enum attributes using different serialization strategies -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithEnumFields">
    <!-- Enum with LITERAL strategy -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusLiteral" eType="#//Status">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="enumSerialization" value="LITERAL"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- Enum with VALUE strategy -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusValue" eType="#//Status">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="enumSerialization" value="VALUE"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- Enum with NAME strategy -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusName" eType="#//Status">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="enumSerialization" value="NAME"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       CONFIGURATION HIERARCHY TESTS (EClass → EReference override)
       ======================================================================== -->

  <!-- Class with type config that references can override -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonWithHierarchyConfig">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <!-- Class-level type config: URI strategy, PLAIN format -->
      <details key="typeStrategy" value="URI"/>
      <details key="typeFormat" value="PLAIN"/>
      <details key="typeKey" value="_type"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference with NO type override - should inherit from class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryAddress" eType="#//Address" containment="true"/>
    <!-- Reference that OVERRIDES type config -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="businessAddress" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- Reference-level override: NAME strategy, STRUCTURED format -->
        <details key="typeStrategy" value="NAME"/>
        <details key="typeFormat" value="STRUCTURED"/>
        <details key="typeKey" value="addressType"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- Reference that PARTIALLY overrides (only format) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="shippingAddress" eType="#//Address" containment="true">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <!-- Only override format, strategy should still come from class -->
        <details key="typeFormat" value="STRUCTURED"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- ========================================================================
       CUSTOM KEY TESTS
       ======================================================================== -->

  <!-- Class with explicit key mapping on features -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityWithCustomKeys">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
