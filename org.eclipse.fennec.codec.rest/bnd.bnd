Bundle-Name: Fennec Codec REST
Bundle-Description: Jakarta REST (JAX-RS) integration for the Fennec EMF Codec

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.codec.api;version=snapshot,\
	osgi.cmpn,\
	org.eclipse.fennec.codec,\
	jakarta.ws.rs-api;version=latest,\
	jakarta.inject.jakarta.inject-api;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.osgi.service.jakartars,\
	org.glassfish.hk2.api,\
	org.glassfish.jersey.core.jersey-common

# The JSON codec is exercised in the writer tests (issue #266)
-testpath.rest: \
	org.eclipse.fennec.codec.metadata;version=project,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest

#So inherited @Reference are put in the service description xml
-dsannotations-options: inherit