{
  "input": {
    "kafka": {
      "addresses": ["localhost:9092"],
      "topics": ["input-topic"],
      "consumer_group": "my-consumer-group",
      "start_from_oldest": true,
      "checkpoint_limit": 1024,
      "auto_replay_nacks": true,
      "tls.enabled": false,
      "sasl.mechanism": "none"
    }
  },
  "pipeline": {
    "processors": [
      {
        "mapping": {
          "script": "root.timestamp = now()"
        }
      },
      {
        "log": {
          "level": "INFO",
          "message": "Processing message"
        }
      }
    ]
  },
  "output": {
    "kafka": {
      "addresses": ["localhost:9092"],
      "topic": "output-topic",
      "tls.enabled": false,
      "sasl.mechanism": "none"
    }
  }
}
