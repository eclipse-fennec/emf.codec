-resourceonly: true
-include: ${.}/buildpath.bnd	
mavendeps: ${sjoin;\n; ${template;-maven-dependencies;${@}}}

-includeresource: {resources}	
	
Provide-Capability: \
	${fennec-base}

fennec-base:\
    bnd.library;\
        bnd.library     = fennecCodec; \
        path            = template
Bundle-Name: Eclispe Fennec Codec
Bundle-Description: Eclipse Fennec Codec Dependencies