-resourceonly: true
-include: ${.}/buildpath.bnd	
mavendeps: ${sjoin;\n; ${template;-maven-dependencies;${@}}}

-includeresource: resources,\
	{template/fennecCodec.maven=resources/template/fennecCodec.maven}	
	
Provide-Capability: \
	${fennec-base}

fennec-base:\
    bnd.library;\
        bnd.library     = fennecCodec; \
        path            = template
Bundle-Name: Fennec Codec
Bundle-Description: Fennec Codec Dependencies