<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="testparity" nsURI="http://test.example.org/format-parity/1.0" nsPrefix="parity">

  <!-- Enum for testing enum serialization -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="LOW" value="0"/>
    <eLiterals name="MEDIUM" value="1"/>
    <eLiterals name="HIGH" value="2"/>
  </eClassifiers>

  <!-- Item - comprehensive test class -->
  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <!-- ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>

    <!-- Various data types -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratio" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enabled" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>

    <!-- Enum attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="#//Priority"/>

    <!-- Multi-valued attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>

    <!-- Containment reference (single) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="detail" eType="#//Detail" containment="true"/>

    <!-- Containment reference (multi) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subItems" upperBound="-1" eType="#//Item" containment="true"/>

    <!-- Non-containment reference (single) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="related" eType="#//Item"/>

    <!-- Non-containment reference (multi) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="links" upperBound="-1" eType="#//Item"/>
  </eClassifiers>

  <!-- Detail - simple contained class -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailText" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Container - root for cross-reference tests -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1" eType="#//Item" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primary" eType="#//Item"/>
  </eClassifiers>

</ecore:EPackage>
