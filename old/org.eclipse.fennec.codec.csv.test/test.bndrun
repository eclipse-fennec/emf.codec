-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.codec.csv.test',\
	bnd.identity;id='org.eclipse.fennec.codec.csv'
	
-runbundles.test: \
	org.eclipse.fennec.codec.csv.test;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-17

-runproperties: \
	data=${.}/data/
	
-runbundles: \
	junit-jupiter-api;version='[5.10.3,5.10.4)',\
	junit-jupiter-params;version='[5.10.3,5.10.4)',\
	junit-platform-commons;version='[1.10.3,1.10.4)',\
	org.apache.commons.commons-codec;version='[1.19.0,1.19.1)',\
	org.apache.commons.commons-csv;version='[1.14.1,1.14.2)',\
	org.apache.commons.commons-io;version='[2.20.0,2.20.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.6,2.2.7)',\
	org.eclipse.emf.common;version='[2.29.0,2.29.1)',\
	org.eclipse.emf.ecore;version='[2.35.0,2.35.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.36.0,2.36.1)',\
	org.eclipse.fennec.codec;version=snapshot,\
	org.eclipse.fennec.codec.constants;version=snapshot,\
	org.eclipse.fennec.codec.csv;version=snapshot,\
	org.eclipse.fennec.codec.csv.test;version=snapshot,\
	org.eclipse.fennec.codec.info;version=snapshot,\
	org.eclipse.fennec.codec.info.model;version=snapshot,\
	org.eclipse.fennec.codec.json;version=snapshot,\
	org.eclipse.fennec.ecowitt.model;version=snapshot,\
	org.gecko.emf.osgi.component.minimal;version='[6.3.0,6.3.1)',\
	org.gecko.emf.util.model;version='[2.2.2,2.2.3)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	assertj-core;version='[3.26.3,3.26.4)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.20.0,2.20.1)',\
	net.bytebuddy.byte-buddy;version='[1.14.18,1.14.19)',\
	tools.jackson.core.jackson-core;version='[3.0.2,3.0.3)',\
	tools.jackson.core.jackson-databind;version='[3.0.2,3.0.3)'