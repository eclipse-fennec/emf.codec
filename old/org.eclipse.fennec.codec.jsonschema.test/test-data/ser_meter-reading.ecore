<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="Root_Schema" nsURI="http://example.com/schemas/root.json">
  <eAnnotations source="http://fennec.eclipse.org/jsonschema">
    <details key="schema" value="http://json-schema.org/draft-07/schema#"/>
    <details key="originalTitle" value="Root Schema"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="MeterReading">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://fennec.eclipse.org/jsonschema">
        <details key="description" value="&quot;The unique identifier for the meter reading.&quot;"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="meter_id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://fennec.eclipse.org/jsonschema">
        <details key="description" value="&quot;The identifier of the meter that the reading came from.&quot;"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://fennec.eclipse.org/jsonschema">
        <details key="description" value="&quot;The value of the meter reading.&quot;"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://fennec.eclipse.org/jsonschema">
        <details key="format" value="&quot;date-time&quot;"/>
        <details key="description" value="&quot;The date and time of the meter reading.&quot;"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
