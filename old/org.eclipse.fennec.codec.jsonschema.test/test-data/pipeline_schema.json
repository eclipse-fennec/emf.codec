{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/redpanda-connect.pipeline.schema.json",
  "title": "redpanda-connect Pipeline Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "pipeline", "output"],
  "properties": {
    "input": { "$ref": "#/$defs/inputNode" },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processors"],
      "properties": {
        "processors": {
          "type": "array",
          "items": { "$ref": "#/$defs/processorNode" },
          "minItems": 1
        }
      }
    },
    "output": { "$ref": "#/$defs/outputNode" }
  },

  "$defs": {
    "inputNode": {
      "description": "Genau EIN Input pro Objekt (z. B. { \"kafka\": { ... } })",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "unevaluatedProperties": false,
      "oneOf": [
        { "required": ["kafka"], "properties": { "kafka": { "$ref": "#/$defs/configs/kafka" } } },
        { "required": ["file"], "properties": { "file": { "$ref": "#/$defs/configs/file" } } },
        { "required": ["csv"], "properties": { "csv": { "$ref": "#/$defs/configs/csv" } } },
        { "required": ["http_client"], "properties": { "http_client": { "$ref": "#/$defs/configs/http_client" } } },
        { "required": ["mqtt"], "properties": { "mqtt": { "$ref": "#/$defs/configs/mqtt" } } },
        { "required": ["aws_s3"], "properties": { "aws_s3": { "$ref": "#/$defs/configs/aws_s3" } } },
        { "required": ["schema_registry"], "properties": { "schema_registry": { "$ref": "#/$defs/configs/schema_registry" } } },
        { "required": ["sql_select"], "properties": { "sql_select": { "$ref": "#/$defs/configs/sql_select" } } },
        { "required": ["sql_raw"], "properties": { "sql_raw": { "$ref": "#/$defs/configs/sql_raw" } } },
        { "required": ["http_server"], "properties": { "http_server": { "$ref": "#/$defs/configs/http_server" } } },
        { "required": ["generate"], "properties": { "generate": { "$ref": "#/$defs/configs/generate" } } },
        { "required": ["broker"], "properties": { "broker": { "$ref": "#/$defs/configs/broker" } } }
      ]
    },

    "processorNode": {
      "description": "Genau EIN Processor/Control pro Objekt (z. B. { \"mapping\": { ... } })",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "unevaluatedProperties": false,
      "oneOf": [
        { "required": ["mapping"], "properties": { "mapping": { "$ref": "#/$defs/configs/mapping" } } },
        { "required": ["bloblang"], "properties": { "bloblang": { "$ref": "#/$defs/configs/bloblang" } } },
        { "required": ["switch"], "properties": { "switch": { "$ref": "#/$defs/configs/switch" } } },
        { "required": ["unarchive"], "properties": { "unarchive": { "$ref": "#/$defs/configs/unarchive" } } },
        { "required": ["sql_select"], "properties": { "sql_select": { "$ref": "#/$defs/configs/sql_select" } } },
        { "required": ["sql_raw"], "properties": { "sql_raw": { "$ref": "#/$defs/configs/sql_raw" } } },
        { "required": ["sql_insert"], "properties": { "sql_insert": { "$ref": "#/$defs/configs/sql_insert" } } },
        { "required": ["sleep"], "properties": { "sleep": { "$ref": "#/$defs/configs/sleep" } } },
        { "required": ["schema_registry_encode"], "properties": { "schema_registry_encode": { "$ref": "#/$defs/configs/schema_registry_encode" } } },
        { "required": ["noop"], "properties": { "noop": { "$ref": "#/$defs/configs/noop" } } },
        { "required": ["log"], "properties": { "log": { "$ref": "#/$defs/configs/log" } } },
        { "required": ["json_schema"], "properties": { "json_schema": { "$ref": "#/$defs/configs/json_schema" } } },
        { "required": ["jq"], "properties": { "jq": { "$ref": "#/$defs/configs/jq" } } },
        { "required": ["jmespath"], "properties": { "jmespath": { "$ref": "#/$defs/configs/jmespath" } } },
        { "required": ["http"], "properties": { "http": { "$ref": "#/$defs/configs/http" } } },
        { "required": ["catch"], "properties": { "catch": { "$ref": "#/$defs/configs/catch" } } },
        { "required": ["branch"], "properties": { "branch": { "$ref": "#/$defs/configs/branch" } } },
        { "required": ["alarm_thresholds"], "properties": { "alarm_thresholds": { "$ref": "#/$defs/configs/alarm_thresholds" } } },
        { "required": ["evaluate_thresholds"], "properties": { "evaluate_thresholds": { "$ref": "#/$defs/configs/evaluate_thresholds" } } },
        { "required": ["confidentiality"], "properties": { "confidentiality": { "$ref": "#/$defs/configs/confidentiality" } } },
        { "required": ["metadata_retrieval"], "properties": { "metadata_retrieval": { "$ref": "#/$defs/configs/metadata_retrieval" } } },
        { "required": ["openapi_validator"], "properties": { "openapi_validator": { "$ref": "#/$defs/configs/openapi_validator" } } },
        { "required": ["directus_mapping"], "properties": { "directus_mapping": { "$ref": "#/$defs/configs/directus_mapping" } } }
      ]
    },

    "outputNode": {
      "description": "Genau EIN Output pro Objekt (z. B. { \"drop\": {} } oder { \"kafka\": { ... } })",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "unevaluatedProperties": false,
      "oneOf": [
        { "required": ["drop"], "properties": { "drop": { "$ref": "#/$defs/configs/drop" } } },
        { "required": ["kafka"], "properties": { "kafka": { "$ref": "#/$defs/configs/kafka" } } },
        { "required": ["http_client"], "properties": { "http_client": { "$ref": "#/$defs/configs/http_client" } } },
        { "required": ["file"], "properties": { "file": { "$ref": "#/$defs/configs/file" } } },
        { "required": ["aws_s3"], "properties": { "aws_s3": { "$ref": "#/$defs/configs/aws_s3" } } },
        { "required": ["mqtt"], "properties": { "mqtt": { "$ref": "#/$defs/configs/mqtt" } } },
        { "required": ["sql_insert"], "properties": { "sql_insert": { "$ref": "#/$defs/configs/sql_insert" } } },
        { "required": ["switch"], "properties": { "switch": { "$ref": "#/$defs/configs/switch" } } },
        { "required": ["switch_output"], "properties": { "switch_output": { "$ref": "#/$defs/configs/switch_output" } } },
        { "required": ["fallback"], "properties": { "fallback": { "$ref": "#/$defs/configs/fallback" } } },
        { "required": ["sync_response"], "properties": { "sync_response": { "$ref": "#/$defs/configs/sync_response" } } }
      ]
    },

    "configs": {
      "http_server": {
        "type": "object",
        "properties": {
          "address": { "type": "string", "default": "0.0.0.0:8080" },
          "path": { "type": "string", "default": "/" },
          "allowed_verbs": { "type": "string", "default": "GET" }
        },
        "required": ["address", "path", "allowed_verbs"],
        "additionalProperties": false
      },

      "mapping": {
        "type": "object",
        "properties": {
          "script": { "type": "string", "default": "root = this" }
        },
        "required": ["script"],
        "additionalProperties": false
      },

      "bloblang": {
        "type": "object",
        "properties": { "script": { "type": "string", "default": "root = this" } },
        "required": ["script"],
        "additionalProperties": false
      },

      "switch": {
        "type": "object",
        "description": "Control node; Branches/Cases werden in der UI gepflegt.",
        "additionalProperties": true
      },

      "sync_response": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "default": "${! meta(\"status\").or(\"200\") }" },
          "headers": {
            "oneOf": [
              { "type": "object", "additionalProperties": { "type": "string" } },
              { "type": "string" }
            ],
            "default": { "Content-Type": "application/json" }
          }
        },
        "required": ["status", "headers"],
        "additionalProperties": false
      },

      "unarchive": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": ["binary","csv","json_array","json_documents","json_map","lines","tar","zip"]
          }
        },
        "required": ["format"],
        "additionalProperties": false
      },

      "sql_select": {
        "oneOf": [
          {
            "title": "Processor Form",
            "type": "object",
            "properties": {
              "driver": { "type": "string", "enum": ["postgres","mysql","clickhouse","mssql","sqlite","oracle","snowflake","trino","gocosmos","spanner"] },
              "dsn": { "type": "string" },
              "table": { "type": "string" },
              "columns": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ]
              },
              "where": { "type": "string" },
              "args_mapping": { "type": "string" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" },
              "init_files": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ],
                "default": []
              },
              "init_statement": { "type": "string" },
              "conn_max_idle_time": { "type": "string" },
              "conn_max_life_time": { "type": "string" },
              "conn_max_idle": { "type": ["integer","string"], "default": 2 },
              "conn_max_open": { "type": ["integer","string"], "default": 0 }
            },
            "required": ["driver","dsn","table","columns"],
            "additionalProperties": false
          },
          {
            "title": "Input Form",
            "type": "object",
            "properties": {
              "driver": { "type": "string", "enum": ["postgres","mysql","clickhouse","mssql","sqlite","oracle","snowflake","trino","gocosmos","spanner"] },
              "dsn": { "type": "string" },
              "table": { "type": "string" },
              "columns": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ]
              },
              "where": { "type": "string" },
              "args_mapping": { "type": "string" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" },
              "init_files": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ],
                "default": []
              },
              "init_statement": { "type": "string" },
              "conn_max_idle_time": { "type": "string" },
              "conn_max_life_time": { "type": "string" },
              "conn_max_idle": { "type": ["integer","string"], "default": 2 },
              "conn_max_open": { "type": ["integer","string"], "default": 0 }
            },
            "required": ["driver","dsn","table","columns"],
            "additionalProperties": false
          }
        ]
      },

      "sql_raw": {
        "oneOf": [
          {
            "title": "Processor/Input Form",
            "type": "object",
            "properties": {
              "driver": { "type": "string", "enum": ["postgres","mysql","clickhouse","mssql","sqlite","oracle","snowflake","trino","gocosmos","spanner"] },
              "dsn": { "type": "string" },
              "query": { "type": "string" },
              "unsafe_dynamic_query": { "type": "boolean", "default": false },
              "args_mapping": { "type": "string" },
              "exec_only": { "type": "boolean", "default": false },
              "queries": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ],
                "default": []
              },
              "init_files": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ],
                "default": []
              },
              "init_statement": { "type": "string" },
              "conn_max_idle_time": { "type": "string" },
              "conn_max_life_time": { "type": "string" },
              "conn_max_idle": { "type": ["integer","string"], "default": 2 },
              "conn_max_open": { "type": ["integer","string"], "default": 0 }
            },
            "required": ["driver","dsn"],
            "additionalProperties": false
          }
        ]
      },

      "sql_insert": {
        "oneOf": [
          {
            "title": "Processor/Output Form",
            "type": "object",
            "properties": {
              "driver": { "type": "string", "enum": ["postgres","mysql","clickhouse","mssql","sqlite","oracle","snowflake","trino","gocosmos","spanner"] },
              "dsn": { "type": "string" },
              "table": { "type": "string" },
              "columns": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ]
              },
              "args_mapping": { "type": "string" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" },
              "init_files": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "string" }
                ],
                "default": []
              },
              "init_statement": { "type": "string" },
              "conn_max_idle_time": { "type": "string" },
              "conn_max_life_time": { "type": "string" },
              "conn_max_idle": { "type": ["integer","string"], "default": 2 },
              "conn_max_open": { "type": ["integer","string"], "default": 0 }
            },
            "required": ["driver","dsn","table","columns","args_mapping"],
            "additionalProperties": false
          }
        ]
      },

      "sleep": {
        "type": "object",
        "properties": {
          "duration": { "type": "string" }
        },
        "required": ["duration"],
        "additionalProperties": false
      },

      "schema_registry_encode": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "subject": { "type": "string" },
          "refresh_period": { "type": "string", "default": "10m" },
          "avro_raw_json": { "type": "boolean", "default": false },

          "oauth.enabled": { "type": "boolean", "default": false },
          "oauth.consumer_key": { "type": "string" },
          "oauth.consumer_secret": { "type": "string" },
          "oauth.access_token": { "type": "string" },
          "oauth.access_token_secret": { "type": "string" },

          "basic_auth.enabled": { "type": "boolean", "default": false },
          "basic_auth.username": { "type": "string" },
          "basic_auth.password": { "type": "string" },

          "jwt.enabled": { "type": "boolean", "default": false },
          "jwt.private_key_file": { "type": "string" },
          "jwt.signing_method": { "type": "string" },
          "jwt.claims": { "type": "object", "additionalProperties": true, "default": {} },
          "jwt.headers": { "type": "object", "additionalProperties": true, "default": {} },

          "tls.skip_cert_verify": { "type": "boolean", "default": false },
          "tls.enable_renegotiation": { "type": "boolean", "default": false },
          "tls.root_cas": { "type": "string" },
          "tls.root_cas_file": { "type": "string" },
          "tls.client_certs": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ],
            "default": []
          }
        },
        "required": ["url","subject"],
        "additionalProperties": false
      },

      "noop": {
        "type": "object",
        "additionalProperties": false
      },

      "log": {
        "type": "object",
        "properties": {
          "level": { "type": "string", "enum": ["TRACE","DEBUG","INFO","WARN","ERROR"], "default": "INFO" },
          "fields_mapping": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["level"],
        "additionalProperties": false
      },

      "json_schema": {
        "type": "object",
        "properties": {
          "schema": { "type": "string" },
          "schema_path": { "type": "string" }
        },
        "anyOf": [
          { "required": ["schema"] },
          { "required": ["schema_path"] }
        ],
        "additionalProperties": false
      },

      "jq": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "default": "." },
          "raw": { "type": "boolean", "default": false },
          "output_raw": { "type": "boolean", "default": false }
        },
        "required": ["query"],
        "additionalProperties": false
      },

      "jmespath": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "default": "@" }
        },
        "required": ["query"],
        "additionalProperties": false
      },

      "http": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "verb": { "type": "string", "default": "GET" },
          "headers": {
            "oneOf": [
              { "type": "object", "additionalProperties": { "type": "string" } },
              { "type": "string" }
            ],
            "default": { "Accept": "application/json" }
          },
          "metadata.include_prefixes": { "type": "string" },
          "metadata.include_patterns": { "type": "string" },
          "rate_limit": { "type": "string" },
          "timeout": { "type": "string", "default": "10s" },
          "parallel": { "type": "boolean", "default": false },

          "oauth.enabled": { "type": "boolean", "default": false },
          "oauth.consumer_key": { "type": "string" },
          "oauth.consumer_secret": { "type": "string" },
          "oauth.access_token": { "type": "string" },
          "oauth.access_token_secret": { "type": "string" },

          "oauth2.enabled": { "type": "boolean", "default": false },
          "oauth2.client_key": { "type": "string" },
          "oauth2.client_secret": { "type": "string" },
          "oauth2.token_url": { "type": "string" },
          "oauth2.scopes": { "type": "string" },
          "oauth2.endpoint_params": { "type": "object", "additionalProperties": true, "default": {} },

          "basic_auth.enabled": { "type": "boolean", "default": false },
          "basic_auth.username": { "type": "string" },
          "basic_auth.password": { "type": "string" },

          "jwt.enabled": { "type": "boolean", "default": false },
          "jwt.private_key_file": { "type": "string" },
          "jwt.signing_method": { "type": "string" },
          "jwt.claims": { "type": "object", "additionalProperties": true, "default": {} },
          "jwt.headers": { "type": "object", "additionalProperties": true, "default": {} },

          "tls.enabled": { "type": "boolean", "default": false },
          "tls.skip_cert_verify": { "type": "boolean", "default": false },
          "tls.enable_renegotiation": { "type": "boolean", "default": false },
          "tls.root_cas": { "type": "string" },
          "tls.root_cas_file": { "type": "string" },
          "tls.client_certs": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ],
            "default": []
          },

          "dump_request_log_level": { "type": "string" },
          "follow_redirects": { "type": "boolean", "default": true },
          "backoff_on": { "type": "string", "default": "429" },
          "drop_on": { "type": "string" },
          "successful_on": { "type": "string" },

          "retries": { "type": ["integer","string"], "default": 3 },
          "retry_period": { "type": "string", "default": "1s" },
          "max_retry_backoff": { "type": "string", "default": "300s" },

          "proxy_url": { "type": "string" },
          "disable_http2": { "type": "boolean", "default": false },
          "batch_as_multipart": { "type": "boolean", "default": false },

          "extract_headers.include_prefixes": { "type": "string" },
          "extract_headers.include_patterns": { "type": "string" }
        },
        "required": ["url"],
        "additionalProperties": false
      },

      "catch": {
        "type": "object",
        "description": "Error-Handler; enthält eine Liste von Prozessoren (in Branch-UI).",
        "additionalProperties": true
      },

      "branch": {
        "type": "object",
        "properties": {
          "request_map": { "type": "string" },
          "result_map": { "type": "string" }
        },
        "additionalProperties": false
      },

      "generate": {
        "type": "object",
        "properties": {
          "interval": { "type": "string" },
          "count": { "type": ["integer","string"] },
          "mapping": { "type": "string", "default": "root = {}" }
        },
        "additionalProperties": false
      },

      "aws_s3": {
        "oneOf": [
          {
            "title": "Input",
            "type": "object",
            "properties": {
              "bucket": { "type": "string" },
              "prefix": { "type": "string" },
              "scanner": { "type": "string", "enum": ["to_the_end","sqs"], "default": "to_the_end" },
              "sqs.url": { "type": "string" },
              "key_path": { "type": "string" },
              "bucket_path": { "type": "string" }
            },
            "required": ["bucket"],
            "additionalProperties": false
          },
          {
            "title": "Output",
            "type": "object",
            "properties": {
              "bucket": { "type": "string" },
              "path": { "type": "string" },
              "content_type": { "type": "string" },
              "timeout": { "type": "string" },
              "batching.count": { "type": ["integer","string"], "default": 0 },
              "batching.period": { "type": "string" }
            },
            "required": ["bucket","path"],
            "additionalProperties": false
          }
        ]
      },

      "broker": {
        "type": "object",
        "properties": {
          "inputs": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "object" } }
            ],
            "default": []
          },
          "copies": { "type": ["integer","string"], "default": 1 },
          "batching.count": { "type": ["integer","string"], "default": 0 },
          "batching.byte_size": { "type": ["integer","string"], "default": 0 },
          "batching.period": { "type": "string" },
          "check": { "type": "string" }
        },
        "additionalProperties": false
      },

      "csv": {
        "type": "object",
        "properties": {
          "paths": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ],
            "default": []
          },
          "parse_header_row": { "type": "boolean", "default": true },
          "delimiter": { "type": "string" },
          "trim_leading_space": { "type": "boolean", "default": false },
          "lazy_quotes": { "type": "boolean", "default": false }
        },
        "required": ["paths"],
        "additionalProperties": false
      },

      "file": {
        "oneOf": [
          {
            "title": "Input",
            "type": "object",
            "properties": {
              "paths": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ],
                "default": []
              },
              "scanner": { "type": "string", "enum": ["lines","to_the_end"], "default": "lines" },
              "auto_replay_nacks": { "type": "boolean", "default": true }
            },
            "required": ["paths"],
            "additionalProperties": false
          },
          {
            "title": "Output",
            "type": "object",
            "properties": {
              "path": { "type": "string", "default": "/tmp/data.txt" },
              "codec": { "type": "string", "enum": ["lines","json_array","delim:","drop"], "default": "lines" }
            },
            "required": ["path","codec"],
            "additionalProperties": false
          }
        ]
      },

      "http_client": {
        "oneOf": [
          {
            "title": "Input",
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "verb": { "type": "string", "default": "GET" },
              "headers": {
                "oneOf": [
