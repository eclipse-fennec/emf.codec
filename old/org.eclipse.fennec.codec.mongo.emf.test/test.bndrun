	org.eclipse.emf.ecore.xmi;version='[2.36.0,2.36.1)',\
	org.mongodb.mongo-java-driver;version='[3.12.14,3.12.15)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.service.log;version='[1.5.0,1.5.1)',\
	org.osgi.service.metatype;version='[1.4.1,1.4.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.gecko.emf.osgi.example.model.basic;version='[6.2.0,6.2.1)',\
	org.gecko.emf.osgi.example.model.extended;version='[6.2.0,6.2.1)',\
	org.gecko.emf.osgi.component.minimal;version='[6.3.0,6.3.1)',\
	org.eclipse.fennec.codec;version=snapshot,\
	org.eclipse.fennec.codec.info;version=snapshot,\
	org.eclipse.fennec.codec.info.model;version=snapshot,\
	org.eclipse.fennec.codec.mongo;version=snapshot,\
	org.eclipse.fennec.codec.mongo.emf.test;version=snapshot,\
	assertj-core;version='[3.26.3,3.26.4)',\
	junit-jupiter-api;version='[5.10.3,5.10.4)',\
	junit-jupiter-params;version='[5.10.3,5.10.4)',\
	junit-platform-commons;version='[1.10.3,1.10.4)',\
	net.bytebuddy.byte-buddy;version='[1.14.18,1.14.19)',\
	org.eclipse.fennec.codec.constants;version=snapshot,\
