Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enable-emf


# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	org.mongodb.mongo-java-driver;version=latest,\
	org.gecko.emf.osgi.api;version=latest,\
	org.gecko.emf.collections;version=latest,\
	org.gecko.mongo.osgi.api;version=latest,\
	org.gecko.mongo.osgi.component;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.gecko.emf.mongo.component;version=latest,\
	org.gecko.emf.mongo.pushstream;version=latest,\
	org.eclipse.fennec.codec.demo.model;version=snapshot,\
	org.eclipse.fennec.codec;version=snapshot,\
	org.eclipse.fennec.codec.info;version=snapshot,\
	org.eclipse.fennec.codec.test.helper;version=snapshot,\
	org.eclipse.fennec.codec.info.model;version=snapshot,\
	org.eclipse.fennec.codec.constants;version=snapshot,\
	tools.jackson.core.jackson-databind;version=latest,\
	tools.jackson.core.jackson-core;version=latest
	
Private-Package: org.eclipse.fennec.codec.mongo.test
