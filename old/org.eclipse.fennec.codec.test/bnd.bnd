Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enable-emf

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	org.eclipse.fennec.codec.info,\
	org.eclipse.fennec.codec.info.model;version=latest,\
	org.eclipse.fennec.codec.demo.model;version=snapshot,\
	org.osgi.test.junit5.cm,\
	org.eclipse.fennec.codec,\
	org.eclipse.fennec.codec.test.helper,\
	org.eclipse.fennec.codec.constants;version=latest,\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	org.eclipse.fennec.codec.json;version=snapshot,\
	org.eclipse.fennec.codec.jsonschema;version=snapshot,\
	org.eclipse.fennec.codec.csv;version=snapshot
	
Private-Package: org.eclipse.fennec.codec.test
