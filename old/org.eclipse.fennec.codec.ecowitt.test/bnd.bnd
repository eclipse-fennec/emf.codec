Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enable-emf,\
	enableOSGi-Test

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	org.eclipse.fennec.codec.constants;version=snapshot,\
	org.eclipse.fennec.codec;version=snapshot,\
	org.eclipse.fennec.codec.ecowitt;version=snapshot,\
	org.eclipse.fennec.ecowitt.model;version=snapshot,\
	org.eclipse.fennec.codec.info;version=snapshot,\
	org.eclipse.fennec.codec.info.model;version=snapshot
	
Private-Package: org.eclipse.fennec.codec.ecowitt.test

Bundle-Version: 1.0.0.SNAPSHOT

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *