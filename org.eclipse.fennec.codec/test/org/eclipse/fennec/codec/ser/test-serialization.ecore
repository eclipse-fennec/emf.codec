<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="testserialization" nsURI="http://test.example.org/serialization/1.0" nsPrefix="ser">

  <!--
    Test model for serialization entry tests.

    Classes:
      - Person (main test class with attributes)
      - Address (for containment reference)
      - Company (for non-containment references)

    Features tested:
      - Single-valued attributes (name, age)
      - Multi-valued attributes (tags)
      - Containment reference (address)
      - Multi-valued containment reference (friends)
      - Non-containment reference (manager)
      - Multi-valued non-containment reference (colleagues)
  -->

  <!-- Address - target for containment references -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Person - main test class -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>

    <!-- Single-valued attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>

    <!-- Multi-valued attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>

    <!-- Derived attribute (should be skipped by default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" changeable="false" volatile="true" transient="true" derived="true"/>

    <!-- Containment reference (single) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="#//Address" containment="true"/>

    <!-- Containment reference (multi-valued) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" eType="#//Person" containment="true"/>

    <!-- Non-containment reference (single) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eType="#//Person"/>

    <!-- Non-containment reference (multi-valued) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="colleagues" upperBound="-1" eType="#//Person"/>
  </eClassifiers>

  <!-- NamedElement - for supertype tests -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Company - extends NamedElement, for supertype serialization tests -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="industry" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1" eType="#//Person" containment="true"/>
  </eClassifiers>

</ecore:EPackage>
