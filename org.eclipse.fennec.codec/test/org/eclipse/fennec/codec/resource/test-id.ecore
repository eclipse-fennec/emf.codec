<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="testid" nsURI="http://test.example.org/id/1.0" nsPrefix="testid">

  <!--
    Test model for ID serialization tests.
    Tests PLAIN and STRUCTURED ID formats, multiple idFeatures, and IdKeyMode.
  -->

  <!-- Person - single ID attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="personId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- MultiId - multiple features for combined ID -->
  <eClassifiers xsi:type="ecore:EClass" name="MultiId">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sequence" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- IdHolder / ContainedId - id via a containment EReference (spec §4, issue #120).
       The contained class carries the id definition; the holder points at the reference. -->
  <eClassifiers xsi:type="ecore:EClass" name="ContainedId">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idFeatures" value="userGroup, userId"/>
      <details key="idSeparator" value="_"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="userGroup" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="userId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="IdHolder">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="idFeatures" value="myId"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="myId" eType="#//ContainedId" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>
